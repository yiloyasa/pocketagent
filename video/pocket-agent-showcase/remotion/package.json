{
  "name": "pocket-agent-showcase-remotion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio --no-open",
    "typecheck": "tsc --noEmit",
    "still:opening": "remotion still PocketAgentShowcase --frame=60 --scale=0.25 --output=../previews/opening.png",
    "still:phone": "remotion still PocketAgentShowcase --frame=450 --scale=0.25 --output=../previews/phone-demo.png",
    "still:pillars": "remotion still PocketAgentShowcase --frame=760 --scale=0.25 --output=../previews/feature-pillars.png",
    "still:ending": "remotion still PocketAgentShowcase --frame=1240 --scale=0.25 --output=../previews/ending.png"
  },
  "dependencies": {
    "@remotion/media": "4.0.506",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.506",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.9.2"
  }
}
