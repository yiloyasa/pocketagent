# ============================================================
# PocketAgent .gitignore
# 原则：只提交「重建不出来」的东西（源码、协议、资源、脚本）。
#       凡是能由源码重新生成的、或运行时产生的，一律不入库。
# ============================================================

# ---------- 构建产物 ----------
build/
.gradle/
.kotlin/
*.apk
*.aab
*.ap_
*.dex
intermediates/
# 发布 zip 由 dist/windows/build.ps1 重建(2026-10-04 裁决:可重建不入库,
# 本地保留供分发;fresh clone 跑 build.ps1 即得)
dist/windows/PocketAgent桌面端.zip
# 总发行包与发布附件由 dist/release.ps1 重建 + GitHub Releases 托管(0.3.1):
# PocketAgent-<ver>-<date>.zip / SHA256SUMS-<ver>.txt / RELEASE_NOTES-<ver>.md
# 【0.4.0 起退役】标准格式只剩双资产：dist/daemon.exe + dist/apk/pocketagent.apk
dist/PocketAgent-*.zip
dist/SHA256SUMS-*.txt
dist/RELEASE_NOTES-*.md
dist/daemon.exe

# ---------- 编译出的可执行文件 ----------
*.exe
*.exe~
*.exe.*            # 带后缀的旧二进制(如 pocketagentd.exe.prev-20260919)——*.exe 匹配不到
*.prev-*
*.dll
*.so
*.dylib
*.test

# ---------- 日志 ----------
*.log

# ---------- 运行时数据 ----------
.pocketagentd/
.pocketagent-uploads/
resumetest-thread.json
# 守护链本机配置(paguard 自读;开发机含 WORKSPACE 个人路径,严禁入库)
daemon/pocketagentd.conf

# ---------- 调试产物（截图 / UI dump）----------
# 验证过程中产生的界面截图与 uiautomator dump，可随时重新生成
android/_verify-*
android/device-*
android/_tap*
_verify-*.png
_verify-*.xml

# ---------- 文档临时抽帧 ----------
# 从参考视频抽取的帧，仅用于分析过程
docs/_video_frames/
docs/_video_frames_ref/

# ---------- Android Studio / IntelliJ ----------
.idea/
*.iml
local.properties
android/app/libs/*.aar
android/app/libs/*.download
# 【2026-10-09 分发资格批】语音模型移出 APK:不再作为 assets 打包(239MB ONNX 曾是
# APK 220MB 的绝对大头),运行时按需下载(SenseVoiceModelFiles)。文件本体移至
# dist/models/ 留档(不入 git);整个 assets 子目录忽略,防止模型被重新放回误打包。
android/app/src/main/assets/sensevoice/
dist/models/
# release 签名密钥库(机密不入库;口令与备份警告见 android/keystore/README.md)
android/keystore/*.jks
android/keystore/*.keystore
captures/
.externalNativeBuild/
.cxx/

# ---------- Node（备用）----------
node_modules/

# ---------- SDD 过程数据(showcase 残留,不入库) ----------
.superpowers/

# ---------- 操作系统 ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 例外：Gradle Wrapper 必须入库 ----------
# 没有它 ./gradlew 无法自举，构建会直接失败
!gradle/wrapper/gradle-wrapper.jar

# ---------- Python 字节码缓存 ----------
__pycache__/
daemon/*.exe.bak-*

# 保留名误建条目(空文件,重启后可删;2026-10-04 收官波遗留)
NUL

# AOCI-CODE: 宿主集成配置含本机绑定的绝对路径,不入库(认知资产 aoci*.txt 必须入库,勿加入忽略)
.zcode/config.json
AGENTS.md.bak-aoci-20261010
.gitignore.bak-aoci-20261010

# AOCI init 的自动备份(本机)
AGENTS.md.backup.*
