<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 核实结论(2026-10-09):本权限无自更新链路,唯一用途是"任务中心下载的
         APK 文件点「查看」交给系统安装器"(PaDownloader.openLocalFile 对
         vnd.android.package-archive 发 ACTION_VIEW,API 26+ 无此权限系统直接拒),
         属用户主动下载文件的打开流程,保留。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 语音输入(运行时再动态申请) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- mDNS 局域网发现(P0-3) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <queries>
        <!-- Android 11+ package visibility: without this, installed system
             recognition services can falsely appear unavailable. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- 核实结论(2026-10-09):gRPC 通道全量 TLS+证书钉扎(AgentConnection.applyPinnedTls,
         非回环目标 TLS 初始化失败即 fail-closed),但存在两处无法按域名精确放行的明文点,
         故保留全局旗子、不能用 networkSecurityConfig 收窄:
         ① 回环豁免:applyPinnedTls 对 127.0.0.1/localhost 在 SSLContext 初始化失败时
           usePlaintext 回退(USB 隧道/本机,报文不出物理主机);
         ② 内置浏览器:BrowserScreen 的 WebView 承载用户任意导航的网页,http:// 主文档
           加载受明文策略管控,NSC 按域名精确放行无法覆盖"用户随手输的任意 http 站"。 -->
    <application
        android:label="PocketAgent"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PocketAgent"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- B4 波次:Flutter UI 宿主(add-to-app)。exported=false —— 只有宿主 app
             自己(设置页「Flutter UI(开发中)」入口)经显式 Intent 拉起,不做深链、
             不响应外部 action。configChanges 与 MainActivity 同口径:Flutter 自己
             管重显,系统不该为此重建 Activity(重建 = Dart 侧状态丢)。 -->
        <activity
            android:name=".flutterhost.FlutterHostActivity"
            android:exported="false"
            android:theme="@style/Theme.PocketAgent"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|fontScale|locale" />
        <service
            android:name=".TurnKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 分享下载目录里的文件(低版本 file:// 路径需要它才能授权给别的 App) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
